# BJ Electronics — Hostinger production environment template
# Import this file in Hostinger only after replacing every required placeholder.
# Never commit a completed production .env file.

# Runtime
NODE_ENV=production

# One canonical Hostinger-managed origin.
# Storefront: /
# Administrator portal: /admin/
# API: /api/
STORE_URL=https://bjelectronics.shop
ADMIN_URL=https://bjelectronics.shop
PUBLIC_API_URL=https://bjelectronics.shop
VITE_STORE_URL=https://bjelectronics.shop
VITE_ADMIN_URL=https://bjelectronics.shop
OAUTH_CALLBACK_BASE_URL=https://bjelectronics.shop

# Keep blank for secure host-only cookies because storefront, admin, and API use one origin.
COOKIE_DOMAIN=

# Required security secrets.
# Generate two different high-entropy values of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-containing-at-least-32-characters
ADMIN_VAULT_KEY=replace-with-a-different-random-secret-containing-at-least-32-characters

# Hostinger MySQL / MariaDB.
# Copy the exact full values from hPanel. Use localhost only when Hostinger displays it.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace-with-the-full-hostinger-database-name
DB_USER=replace-with-the-full-hostinger-database-user
DB_PASSWORD=replace-with-a-strong-database-password
DB_CONNECTION_LIMIT=10

# Initial administrator seed.
ADMIN_NAME=Store Administrator
ADMIN_EMAIL=replace-with-the-administrator-email
ADMIN_PHONE=
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
SEED_DEMO_USER=false

# Optional administrator OAuth boot credentials.
# Leave an entire provider group blank when it is not configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Redis-compatible cache through Upstash HTTPS REST.
# Both URL and token are required together.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_NAMESPACE=bj-electronics:production
REDIS_CATALOG_TTL_SECONDS=300
REDIS_REVIEW_TTL_SECONDS=60
REDIS_REQUEST_TIMEOUT_MS=2500
REDIS_REQUIRED=false

# Optional Cloudinary signed media uploads.
# Cloud name, API key, and API secret are required together.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=bj-electronics/products
CLOUDINARY_SIGNATURE_ALGORITHM=sha256
CLOUDINARY_REQUIRED=false

# Hostinger supplies PORT automatically. Do not add or override PORT.
# Redeploy the Node.js application after changing any environment variable.
