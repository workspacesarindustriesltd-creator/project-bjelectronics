{
  "name": "bj-electronics-store",
  "version": "3.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "dev:full": "concurrently -n WEB,API -c blue,red \"vite\" \"node --watch server/index.js\"",
    "start": "node server/index.js",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test server/tests/*.test.mjs tests/sites-worker.test.mjs",
    "test:api": "node --test server/tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "check": "npm test && npm run build",
    "security:audit": "npm audit --audit-level=high --omit=dev",
    "db:seed-users": "node server/seed-users.js",
    "db:seed-catalog": "node server/seed-catalog.js"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.23.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sslcommerz-lts": "^1.2.0",
    "vite": "6.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
