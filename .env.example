NODE_ENV=development
PORT=4000
STORE_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
PUBLIC_API_URL=http://localhost:4000
VITE_STORE_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5174
JWT_SECRET=replace-with-a-random-secret-containing-at-least-32-characters
COOKIE_DOMAIN=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bj_electronics
DB_CONNECTION_LIMIT=10

# Redis-compatible cache through Upstash HTTPS REST.
# Leave both blank to run without distributed caching.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_NAMESPACE=bj-electronics:development
REDIS_CATALOG_TTL_SECONDS=300
REDIS_REVIEW_TTL_SECONDS=60
REDIS_REQUEST_TIMEOUT_MS=2500
REDIS_REQUIRED=false

# Cloudinary signed media uploads.
# Leave all three credentials blank to disable cloud media locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=bj-electronics/products
CLOUDINARY_SIGNATURE_ALGORITHM=sha256
CLOUDINARY_REQUIRED=false

ADMIN_NAME=Store Administrator
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
SEED_DEMO_USER=false
